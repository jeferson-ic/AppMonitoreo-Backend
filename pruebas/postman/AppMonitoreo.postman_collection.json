{
  "info": {
    "name": "AppMonitoreo API",
    "description": "Pruebas de la API REST de AppMonitoreo.\n\n1. Selecciona el entorno (Local o Render).\n2. Completa adminCorreo y adminContrasena en el entorno.\n3. Ejecuta la colección completa con Run collection, en orden.\n\nLos tokens y los IDs de incidentes se guardan automáticamente entre peticiones.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "0. Estado del servicio",
      "description": "Verifica que el backend esté en línea.",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            },
            "description": "Público. Devuelve el estado del servicio.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Estado UP\", () => pm.expect(pm.response.json().status).to.eql(\"UP\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Autenticación (RF01)",
      "description": "Registro e inicio de sesión. El login guarda el token automáticamente.",
      "item": [
        {
          "name": "Registrar usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Crea un usuario nuevo. El correo se genera automáticamente para poder repetir la prueba.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario de Prueba\",\n  \"correo\": \"{{correoUsuario}}\",\n  \"contrasena\": \"{{contrasenaUsuario}}\",\n  \"telefono\": \"987654321\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"correoUsuario\", \"usuario\" + Date.now() + \"@test.com\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar correo duplicado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Debe rechazar un correo ya registrado (409).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario Duplicado\",\n  \"correo\": \"{{correoUsuario}}\",\n  \"contrasena\": \"{{contrasenaUsuario}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar con datos inválidos",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Nombre vacío, correo mal formado y contraseña débil: debe responder 400 con el detalle de cada campo.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"\",\n  \"correo\": \"correo-invalido\",\n  \"contrasena\": \"123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Incluye detalles\", () => pm.expect(pm.response.json()).to.have.property(\"detalles\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Inicia sesión con el usuario registrado y guarda el token en la variable token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correoUsuario}}\",\n  \"contrasena\": \"{{contrasenaUsuario}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Devuelve token\", () => pm.expect(json.token).to.be.a(\"string\").and.not.empty);",
                  "pm.collectionVariables.set(\"token\", json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login con contraseña incorrecta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Debe responder 401.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correoUsuario}}\",\n  \"contrasena\": \"ClaveIncorrecta1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login administrador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Inicia sesión como ADMIN y guarda el token en adminToken. Completa adminCorreo y adminContrasena en el entorno.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{adminCorreo}}\",\n  \"contrasena\": \"{{adminContrasena}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Rol ADMIN\", () => pm.expect(json.rol).to.eql(\"ADMIN\"));",
                  "pm.collectionVariables.set(\"adminToken\", json.token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Incidentes (RF02, RF03, RF05, RF09)",
      "description": "Reporte, consulta y filtros de incidentes.",
      "item": [
        {
          "name": "Listar tipos de incidente",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/incidentes/tipos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidentes",
                "tipos"
              ]
            },
            "description": "Catálogo de tipos disponibles."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear incidente (riesgo ALTO)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/incidentes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidentes"
              ]
            },
            "description": "Reporta un incidente. 'Asalto' recibe nivel de riesgo ALTO y genera una alerta. Guarda el id en incidenteId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipoIncidente\": \"Asalto\",\n  \"descripcion\": \"Asalto a transeúnte en la esquina del parque\",\n  \"latitud\": -12.046374,\n  \"longitud\": -77.042793\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test(\"Riesgo ALTO\", () => pm.expect(json.nivelRiesgo).to.eql(\"ALTO\"));",
                  "pm.test(\"Estado PENDIENTE\", () => pm.expect(json.estado).to.eql(\"PENDIENTE\"));",
                  "pm.collectionVariables.set(\"incidenteId\", json.idIncidente);"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear incidente con fecha (riesgo BAJO)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/incidentes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidentes"
              ]
            },
            "description": "Reporta un incidente indicando la fecha en que ocurrió. Guarda el id en incidenteId2.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipoIncidente\": \"Sospechoso\",\n  \"descripcion\": \"Persona merodeando vehículos estacionados\",\n  \"latitud\": -12.05021,\n  \"longitud\": -77.035512,\n  \"fechaIncidente\": \"2026-01-15T20:30:00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test(\"Riesgo BAJO\", () => pm.expect(json.nivelRiesgo).to.eql(\"BAJO\"));",
                  "pm.collectionVariables.set(\"incidenteId2\", json.idIncidente);"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear incidente inválido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/incidentes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidentes"
              ]
            },
            "description": "Coordenadas fuera de rango y descripción vacía: debe responder 400.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipoIncidente\": \"Robo\",\n  \"descripcion\": \"\",\n  \"latitud\": 120.5,\n  \"longitud\": -200.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar incidentes (mapa)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/incidentes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidentes"
              ]
            },
            "description": "Todos los incidentes visibles en el mapa."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Devuelve una lista\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Filtrar por tipo, riesgo y fechas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/incidentes?tipo=Asalto&nivelRiesgo=ALTO&fechaDesde=2026-01-01&fechaHasta=2026-12-31",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidentes"
              ],
              "query": [
                {
                  "key": "tipo",
                  "value": "Asalto"
                },
                {
                  "key": "nivelRiesgo",
                  "value": "ALTO"
                },
                {
                  "key": "fechaDesde",
                  "value": "2026-01-01"
                },
                {
                  "key": "fechaHasta",
                  "value": "2026-12-31"
                }
              ]
            },
            "description": "Filtros opcionales y combinables. Fechas en formato yyyy-MM-dd."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Solo riesgo ALTO\", () => pm.response.json().forEach(i => pm.expect(i.nivelRiesgo).to.eql(\"ALTO\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Incidentes cercanos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/incidentes/cercanos?lat=-12.046374&lng=-77.042793&radioKm=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidentes",
                "cercanos"
              ],
              "query": [
                {
                  "key": "lat",
                  "value": "-12.046374"
                },
                {
                  "key": "lng",
                  "value": "-77.042793"
                },
                {
                  "key": "radioKm",
                  "value": "1"
                }
              ]
            },
            "description": "Incidentes dentro de un radio (km) de una ubicación."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Responde en menos de 3 s\", () => pm.expect(pm.response.responseTime).to.be.below(3000));"
                ]
              }
            }
          ]
        },
        {
          "name": "Zonas de riesgo",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/incidentes/zonas-riesgo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidentes",
                "zonas-riesgo"
              ]
            },
            "description": "Las 20 zonas con más incidentes."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Mis reportes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/incidentes/mis-reportes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "incidentes",
                "mis-reportes"
              ]
            },
            "description": "Historial de reportes del usuario autenticado."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Incluye mis reportes\", () => pm.expect(pm.response.json().length).to.be.at.least(1));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Alertas (RF04)",
      "description": "Detección de zona de riesgo alto.",
      "item": [
        {
          "name": "Verificar ubicación en zona de riesgo",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/alertas/verificar?lat=-12.046400&lng=-77.042800&radioMetros=300",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "alertas",
                "verificar"
              ],
              "query": [
                {
                  "key": "lat",
                  "value": "-12.046400"
                },
                {
                  "key": "lng",
                  "value": "-77.042800"
                },
                {
                  "key": "radioMetros",
                  "value": "300"
                }
              ]
            },
            "description": "Ubicación junto al incidente ALTO creado antes: debe indicar enZonaDeRiesgo = true."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"En zona de riesgo\", () => pm.expect(pm.response.json().enZonaDeRiesgo).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "Verificar ubicación segura",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/alertas/verificar?lat=-11.500000&lng=-76.500000&radioMetros=300",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "alertas",
                "verificar"
              ],
              "query": [
                {
                  "key": "lat",
                  "value": "-11.500000"
                },
                {
                  "key": "lng",
                  "value": "-76.500000"
                },
                {
                  "key": "radioMetros",
                  "value": "300"
                }
              ]
            },
            "description": "Ubicación lejana: debe indicar enZonaDeRiesgo = false."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Fuera de zona de riesgo\", () => pm.expect(pm.response.json().enZonaDeRiesgo).to.be.false);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Usuario",
      "description": "Datos del usuario autenticado.",
