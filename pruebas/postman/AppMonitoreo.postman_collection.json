    {
      "name": "5. Administración (RF06, RF07, RF08)",
      "description": "Requiere ejecutar antes 'Login administrador'.",
      "item": [
        {
          "name": "Incidentes pendientes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/incidentes/pendientes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "incidentes",
                "pendientes"
              ]
            },
            "description": "Reportes pendientes de revisión.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
